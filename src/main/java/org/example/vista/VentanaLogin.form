<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.example.vista.VentanaLogin">
  <grid id="rootLogin" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="5" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="24" left="30" bottom="24" right="30"/>
    <constraints>
      <xy x="20" y="20" width="470" height="330"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="lblTitulo" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Segoe UI" size="22" style="1"/>
          <text value="Biblioteca Escolar"/>
        </properties>
      </component>
      <component id="lblUsuario" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="RUT / correo:"/>
        </properties>
      </component>
      <component id="campoUsuario" class="javax.swing.JTextField" binding="txtIdentificador">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="lblClave" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Contraseña:"/>
        </properties>
      </component>
      <component id="campoClave" class="javax.swing.JPasswordField" binding="txtContrasena">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="botonIngresar" class="javax.swing.JButton" binding="btnIngresar">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="260" height="40"/>
          </grid>
        </constraints>
        <properties>
          <text value="Ingresar"/>
        </properties>
      </component>
      <component id="estadoLogin" class="javax.swing.JLabel" binding="lblEstado">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value=" "/>
        </properties>
      </component>
    </children>
  </grid>
</form>
